# Kopiér variabler til Railway → Service → Variables (ikke commit secrets).

ENVIRONMENT=production
LOG_FORMAT=json
# Railway: WARNING (undgår log rate limit). Lokal dev: INFO
LOG_LEVEL=WARNING

# Fra Timescale Cloud eller Postgres med TimescaleDB-extension
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Timescale Cloud / Railway: ofte nødvendigt pga. certifikat-kæde
DATABASE_SSL_INSECURE=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=3

BANKROLL_USD=10000

FRED_API_KEY=
